{
  "name": "doble-llave-android",
  "version": "1.0.0",
  "private": true,
  "description": "Doble Llave como app de Android (Capacitor). La web de siempre, dentro de una APK.",
  "scripts": {
    "web": "node scripts/preparar-web.mjs",
    "sync": "node scripts/preparar-web.mjs && cap sync android",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug",
    "abrir": "cap open android"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2"
  }
}
